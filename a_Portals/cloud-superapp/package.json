{
  "name": "cloud-superapp",
  "version": "1.0.0",
  "description": "Web replica of the Cloud SuperApp Android launcher UI",
  "main": "dist/index.html",
  "scripts": {
    "build": "bash build.sh build",
    "dev": "bash build.sh dev",
    "clean": "bash build.sh clean",
    "lint": "eslint src/typescript/**/*.ts",
    "format": "prettier --write \"src/**/*.{ts,scss}\"",
    "nav:sync": "node scripts/gen-nav.mjs",
    "nav:check": "node scripts/gen-nav.mjs --check",
    "test": "node test/embed.spec.mjs"
  },
  "keywords": [
    "cloud",
    "mobile",
    "launcher",
    "typescript",
    "sass"
  ],
  "author": "Diego Nepomuceno Marcos",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "esbuild": "^0.19.8",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "sass": "^1.69.5",
    "typescript": "^5.3.2"
  }
}
